rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ใช้ตอนล็อกอินด้วย username: ต้องอ่านได้ "ก่อน" ล็อกอินเพื่อแปลงเป็น email
    // เขียนได้แค่ตอนสมัครสมาชิกและต้องเป็นเจ้าของ uid ที่ระบุเท่านั้น ห้ามแก้/ลบภายหลัง
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // โปรไฟล์สาธารณะเบา ๆ ของผู้ใช้ (ใช้แสดงชื่อในแชท) อ่านได้ทุกคนที่ล็อกอินแล้ว
    // แก้ไขได้เฉพาะเจ้าของบัญชี
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ห้องแชท: อ่าน/แก้ไขได้เฉพาะคนที่เป็นหนึ่งใน participants เท่านั้น
    match /chats/{chatId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
