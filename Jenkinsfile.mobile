// taskflow-mobile (PetPaws Flutter app) pipeline, Lab 10.
// Runs entirely on an ephemeral Kubernetes pod in the kind cluster (Lab 09 cloud "kind").
// Jenkins job: multibranch "taskflow-mobile", Script Path = Jenkinsfile.mobile
pipeline {
    agent {
        kubernetes {
            cloud 'kind'
            // ghcr.io is where Cirrus Labs publishes cirruslabs/flutter (it is not on Docker Hub)
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: flutter
    image: ghcr.io/cirruslabs/flutter:stable
    command: ['cat']
    tty: true
    resources:
      requests: { cpu: "1", memory: 3Gi }
  - name: osv
    image: ghcr.io/google/osv-scanner:latest
    command: ['cat']
    tty: true
  - name: node
    image: node:24-alpine
    command: ['cat']
    tty: true
'''
            defaultContainer 'flutter'
        }
    }

    options {
        // First Gradle build downloads the Android toolchain; later ones are much faster
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Setup') {
            steps {
                // The workspace is owned by the jnlp container's user; git refuses it otherwise
                sh 'git config --global --add safe.directory "*"'
                sh 'flutter --version'
                sh 'flutter pub get'
            }
        }
        stage('Checks') {
            // Independent of each other, so they run side by side
            parallel {
                stage('flutter analyze') {
                    // Errors and warnings fail the build; infos (deprecation notices) are reported only
                    steps { sh 'flutter analyze --no-fatal-infos' }
                }
                stage('flutter test') {
                    steps { sh 'flutter test --coverage' }
                    post {
                        always { archiveArtifacts artifacts: 'coverage/lcov.info', allowEmptyArchive: true }
                    }
                }
                stage('SCA - osv-scanner') {
                    steps {
                        container('osv') {
                            // Exits non-zero when pubspec.lock has a known vulnerability, which blocks the build
                            sh '/osv-scanner scan source --lockfile pubspec.lock --format table'
                        }
                    }
                }
            }
        }
        stage('Build Debug APK') {
            // Every branch: a quick installable build for testers
            steps {
                sh 'flutter build apk --debug'
                archiveArtifacts artifacts: 'build/app/outputs/flutter-apk/app-debug.apk', fingerprint: true
            }
        }
        stage('Pipeline Health Gate') {
            // Same gate as the API (ci/health-gate.mjs): no release while under 90% of this job's
            // last 20 builds succeeded. Runs in the pod's node container; the kind node resolves the
            // Prometheus container by name because both sit on the "kind" Docker network.
            when { anyOf { branch 'main'; branch pattern: 'demo/.*', comparator: 'REGEXP' } }
            environment {
                PROMETHEUS_URL = 'http://jenkins-monitoring-prometheus-1:9090'
                MIN_SUCCESS_RATE = '0.9'
                WINDOW_BUILDS = '20'
                MIN_HISTORY = "${env.BRANCH_NAME == 'main' ? '5' : '1'}"
            }
            steps { container('node') { sh 'node ci/health-gate.mjs' } }
        }
        stage('Build Signed Release AAB') {
            // main only: the keystore never leaves Jenkins credentials and is never used on branches
            when { branch 'main' }
            steps {
                withCredentials([file(credentialsId: 'android-keystore', variable: 'ANDROID_KEYSTORE'),
                                 string(credentialsId: 'android-keystore-pass', variable: 'ANDROID_KEYSTORE_PASSWORD')]) {
                    // android/app/build.gradle.kts reads these to sign the release bundle
                    withEnv(['ANDROID_KEY_ALIAS=upload']) {
                        sh 'flutter build appbundle --release'
                    }
                    // Prove it is signed with our key, not the debug key
                    sh 'keytool -printcert -jarfile build/app/outputs/bundle/release/app-release.aab | head -5'
                }
                archiveArtifacts artifacts: 'build/app/outputs/bundle/release/app-release.aab', fingerprint: true
            }
        }
    }

    post {
        // Same notification as the API pipeline: result, branch and build URL. NOTIFY_EMAIL and the
        // SMTP server are Jenkins settings (Mailpit inbox at http://localhost:8025); a mail outage
        // must not fail the build.
        always {
            script {
                def result = currentBuild.currentResult
                try {
                    mail to: env.NOTIFY_EMAIL,
                         subject: "${result}: ${env.JOB_NAME} [${env.BRANCH_NAME}] #${env.BUILD_NUMBER}",
                         body: "taskflow-mobile build #${env.BUILD_NUMBER} on branch ${env.BRANCH_NAME}: ${result}\n\n" +
                               "Build: ${env.BUILD_URL}\nConsole: ${env.BUILD_URL}console\n"
                } catch (err) {
                    echo "Notification not sent: ${err.message}"
                }
            }
        }
    }
}
